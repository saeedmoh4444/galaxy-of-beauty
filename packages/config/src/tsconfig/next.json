{
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    // Flags still being migrated app-wide (audit stage 9) — re-enabled
    // incrementally; noUncheckedIndexedAccess is enforced already.
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  }
}
