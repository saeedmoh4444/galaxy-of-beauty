    hourEnd       Int?     // 0-23
    priceMultiplier Decimal @db.Decimal(3, 2) @default(1.0) // 1.0=normal, 1.3=30% surge
    technicianTier String? // NEW, EXPERIENCED, PREMIUM, CELEBRITY
    labelJson     Json?    // { ar, en } — e.g. "أسعار نهاية الأسبوع"
    isActive      Boolean  @default(true)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([serviceId, dayOfWeek, isActive])
    @@map("pricing_rules")
  }

  // ── Service Bundles ──────────────────────────────────────
  model BeautyBundle {
    id            Int      @id @default(autoincrement())
    titleJson     Json     // { ar, en }
    descriptionJson Json?
    serviceIds    Int[]    // Array of service IDs bundled together
    discountPct   Int      @default(10) // e.g. 20 = 20% off
    totalPrice    Decimal  @db.Decimal(10, 2) // Final price after discount
    originalPrice Decimal  @db.Decimal(10, 2) // Sum of individual service prices
    imageUrl      String?  // Bundle hero image
    isActive      Boolean  @default(true)
    isSeasonal    Boolean  @default(false)
    season        String?  // EID, RAMADAN, GRADUATION, WEDDING, WEEKEND
    validFrom     DateTime?
    validUntil    DateTime?
    sortOrder     Int      @default(0)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([isActive, sortOrder])
    @@map("beauty_bundles")
  }

  // ── Beauty Subscriptions ──────────────────────────────────
  model BeautyPlan {
    id            Int      @id @default(autoincrement())
    nameJson      Json     // { ar, en }
    descriptionJson Json?
    priceMonthly  Decimal  @db.Decimal(10, 2)
    priceAnnual   Decimal? @db.Decimal(10, 2)
    maxBookings   Int      @default(4) // Bookings per month
    discountPct   Int      @default(10) // Percent off additional services
    features      Json     // ["priority_booking", "free_home_service", "dedicated_tech"]
    isActive      Boolean  @default(true)
    sortOrder     Int      @default(0)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@map("beauty_plans")
  }



