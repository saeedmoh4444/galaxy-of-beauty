{
  "name": "@galaxy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 200",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "socket": "tsx src/socket/server.ts",
    "worker": "tsx src/workers/run.ts",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@galaxy/db": "workspace:*",
    "@galaxy/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@sentry/node": "^11.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@trpc/server": "^11.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.11",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@galaxy/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
