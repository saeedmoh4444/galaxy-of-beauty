{
  "name": "@galaxy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 200",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "socket": "tsx src/socket/server.ts",
    "worker": "tsx src/workers/run.ts"
  },
  "dependencies": {
    "@galaxy/db": "workspace:*",
    "@galaxy/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "superjson": "^2.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@galaxy/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.4.2",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^3.1.1"
  }
}
