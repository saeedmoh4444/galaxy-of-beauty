  "devDependencies": {
    "@galaxy/config": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  }
