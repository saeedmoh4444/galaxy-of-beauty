{
  "name": "@galaxy/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8083",
    "dev": "expo start --port 8083",
    "dev:fix": "set NODE_OPTIONS=--no-experimental-fetch && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings 200",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo dist",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@galaxy/api": "workspace:*",
    "@galaxy/db": "workspace:*",
    "@galaxy/shared": "workspace:*",
    "@galaxy/ui": "workspace:^",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "expo": "~58.0.16",
    "expo-camera": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.17",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0-rc.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webrtc": "124.0.8",
    "react-native-webview": "14.0.1",
    "socket.io-client": "^4.8.4",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
