{
  "name": "@galaxy/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "dev:fix": "set NODE_OPTIONS=--no-experimental-fetch && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 200",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.12",
    "@galaxy/api": "workspace:*",
    "@galaxy/db": "workspace:*",
    "@galaxy/shared": "workspace:*",
    "@galaxy/ui": "workspace:^",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "expo": "~57.0.15",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3",
    "superjson": "^2.2.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@galaxy/config": "workspace:*",
    "@types/react": "~19.2.18",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3"
  }
}
