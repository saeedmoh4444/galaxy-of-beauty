{
  "name": "@galaxy/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8083",
    "dev": "expo start --port 8083",
    "dev:fix": "set NODE_OPTIONS=--no-experimental-fetch && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "lint": "eslint . --max-warnings 200",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .expo .turbo dist",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@galaxy/api": "workspace:*",
    "@galaxy/db": "workspace:*",
    "@galaxy/shared": "workspace:*",
    "@galaxy/ui": "workspace:^",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "124.0.8",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@galaxy/config": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  }
}
