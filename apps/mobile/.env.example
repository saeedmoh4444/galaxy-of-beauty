# Expo
EXPO_PUBLIC_API_URL="http://localhost:3000/api/trpc"
EXPO_PUBLIC_SOCKET_URL="http://localhost:4001"

# Sentry (optional) — src/lib/sentry.ts is DSN-gated: empty = no-op.
