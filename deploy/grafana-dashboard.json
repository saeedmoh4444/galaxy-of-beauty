{
  "dashboard": {
    "title": "Galaxy of Beauty — Production",
    "tags": ["gob", "production"],
    "timezone": "asia/riyadh",
    "panels": [
      {
        "title": "Request Rate",
        "type": "graph",
        "targets": [{ "expr": "rate(http_requests_total[1m])", "legendFormat": "{{status}}" }],
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{status=\"5xx\"}[5m]) / rate(http_requests_total[5m])",
            "legendFormat": "error rate"
          }
        ],
        "thresholds": [{ "value": 0.05, "color": "red" }],
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
      },
      {
        "title": "Response Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 }
      },
      {
        "title": "Bookings Today",
        "type": "stat",
        "targets": [{ "expr": "bookings_created_total" }],
        "gridPos": { "x": 8, "y": 8, "w": 4, "h": 4 }
      },
      {
        "title": "Active Users (7d)",
        "type": "stat",
        "targets": [{ "expr": "active_users" }],
        "gridPos": { "x": 12, "y": 8, "w": 4, "h": 4 }
      },
      {
        "title": "DB Connections",
        "type": "graph",
        "targets": [{ "expr": "pg_stat_activity_count" }],
        "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 }
      },
      {
        "title": "Redis Memory",
        "type": "graph",
        "targets": [{ "expr": "redis_memory_used_bytes / 1024 / 1024", "legendFormat": "used MB" }],
        "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 }
      },
      {
        "title": "Node.js Heap",
        "type": "graph",
        "targets": [{ "expr": "nodejs_heap_used_bytes / 1024 / 1024", "legendFormat": "heap MB" }],
        "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 }
      }
    ]
  }
}
