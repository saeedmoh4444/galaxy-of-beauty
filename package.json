{
  "name": "galaxy-of-beauty",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:migrate:deploy": "turbo run db:migrate:deploy",
    "db:migrate:status": "turbo run db:migrate:status",
    "db:seed": "turbo run db:seed",
    "db:validate": "turbo run db:validate",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:a11y": "pnpm --filter @galaxy/web exec playwright test e2e/axe-a11y.spec.ts",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:budgets": "node scripts/check-size-budgets.mjs",
    "graph": "node scripts/gen-dependency-graph.mjs",
    "load:smoke": "k6 run scripts/load/smoke.js",
    "load:load": "k6 run scripts/load/load.js",
    "audit:prod": "pnpm audit --prod",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm db:validate && pnpm test:unit && pnpm check:cycles && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "prettier --write",
    "*.{json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2": "1.1.18",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.9",
      "sharp": ">=0.35.0",
      "socket.io-parser": ">=4.2.7"
    },
    "patchedDependencies": {
      "@expo/cli@57.0.27": "patches/@expo__cli@57.0.27.patch",
      "@expo/metro-config@57.0.12": "patches/@expo__metro-config@57.0.12.patch"
    }
  }
}
