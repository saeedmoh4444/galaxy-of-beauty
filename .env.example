# ═══════════════════════════════════════════
# Galaxy of Beauty — Environment Variables
# ═══════════════════════════════════════════
# Copy to .env and fill in your values
# cp .env.example .env

# ── Database (PostgreSQL) ─────────────────
DATABASE_URL="postgresql://gob_admin:gob_secure_pass@localhost:5432/Galaxy_of_Beauty_db?schema=public"

# ── Redis ─────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT Secrets ───────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-32-char-random-secret"
JWT_REFRESH_SECRET="replace-with-32-char-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── Application ────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"
CORS_ORIGIN="http://localhost:3000"

# ── Mobile (Expo) ──────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3000/api/trpc"

# ── Optional: External Services ────────────
# OPENAI_API_KEY="sk-..."
# SENTRY_DSN="https://..."
# PAYFORT_MERCHANT_ID="..."
# PAYFORT_ACCESS_CODE="..."
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="..."
# SMTP_PASS="..."
# ZATCA_SIMULATE="true"
# ZATCA_VAT_NUMBER="300000000000003"
