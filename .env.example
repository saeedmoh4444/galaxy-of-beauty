# ═══════════════════════════════════════════
# Galaxy of Beauty — Environment Variables
# ═══════════════════════════════════════════
# Copy to .env:  cp .env.example .env
# All vars validated by Zod in packages/api/src/lib/env.ts

# ── REQUIRED: Database ──────────────────────────────
DATABASE_URL="postgresql://gob_admin:gob_secure_pass@localhost:5432/Galaxy_of_Beauty_db?schema=public"

# ── REQUIRED: Redis ─────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── REQUIRED: JWT (min 32 chars) ───────────────────
JWT_ACCESS_SECRET="example-access-0123456789abcdef0123456789abcdef"
JWT_REFRESH_SECRET="example-refresh-0123456789abcdef0123456789abcdef"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── REQUIRED: Application ───────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4001"
CORS_ORIGIN="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000/api/trpc"
PORT="3000"
SOCKET_PORT="4001"

# ── OPTIONAL: Error Tracking (Sentry) ──────────────
# Missing → errors logged to console only
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# ── OPTIONAL: AI Chatbot "Beauty Galaxy" (OpenAI) ──────────
# Missing → AI returns "المساعدة غير متوفرة حالياً"
# OPENAI_API_KEY="sk-..."

# ── OPTIONAL: Payment Gateway (PayFort/APS) ─────────
# Missing → uses development stub, no real charges
# PAYFORT_MERCHANT_ID="..."
# PAYFORT_ACCESS_CODE="..."
# PAYFORT_SHA_REQUEST_PHRASE="..."
# PAYFORT_SHA_RESPONSE_PHRASE="..."
# PAYFORT_SANDBOX="true"

# ── OPTIONAL: Email Notifications ───────────────────
# Missing → emails logged to console, not sent
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="SG...."
# EMAIL_FROM="noreply@galaxyofbeauty.sa"

# ── OPTIONAL: SMS Notifications (Twilio) ────────────
# Missing → SMS disabled, in-app notifications still work
# TWILIO_ACCOUNT_SID="..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE_NUMBER="+966..."

# ── OPTIONAL: ZATCA E-Invoicing ─────────────────────
# Missing → mock sandbox (ZATCA_SIMULATE=true)
ZATCA_SIMULATE="true"
# ZATCA_VAT_NUMBER="300000000000003"
# ZATCA_API_KEY="..."
# ZATCA_API_SECRET="..."
# ZATCA_API_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"

# ── OPTIONAL: Google OAuth + Calendar ───────────────
# Missing → Google login + calendar sync disabled
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."

# ── OPTIONAL: AWS S3 (Uploads) ──────────────────────
# Missing → files stored locally in /uploads
# AWS_REGION="me-central-1"
# AWS_S3_BUCKET="gob-uploads"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# ── OPTIONAL: Mobile CI/CD (Expo EAS) ───────────────
# Missing → EAS Build runs locally only
# EXPO_ACCESS_TOKEN="..."

# ── OPTIONAL: Business Config ───────────────────────
# PLATFORM_FEE_SAR="11"
# REFERRAL_CAMPAIGN_START="2026-01-01"
# BUSINESS_NAME_AR="جالكسي بيوتي"
# UPLOAD_DIR="./uploads"
# LOG_LEVEL="info"
