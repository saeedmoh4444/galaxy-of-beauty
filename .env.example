# =============================================================================
# Galaxy of Beauty — Environment Variables
# =============================================================================
# Copy to .env and fill in your values
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://gob_admin:gob_secure_pass@localhost:5432/Galaxy_of_Beauty_db"

# --- Redis ---
REDIS_URL=
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=
JWT_REFRESH_EXPIRY=

# --- Next.js ---
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# --- OpenAI (AI Chatbot Layla + Skin Analysis) ---
OPENAI_API_KEY=

# --- Google Calendar (Technician Sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- PayFort / Amazon Payment Services ---
PAYFORT_MERCHANT_ID=
PAYFORT_ACCESS_KEY=
PAYFORT_SHA_REQUEST_PHRASE=
PAYFORT_SHA_RESPONSE_PHRASE=
PAYFORT_SANDBOX=

# --- Expo Push Notifications ---
EXPO_ACCESS_TOKEN=

# --- ZATCA E-Invoicing ---
ZATCA_VAT_NUMBER=
ZATCA_API_URL=
ZATCA_API_KEY=
ZATCA_API_SECRET=

# --- SMS (Optional) ---
SMS_API_KEY=
SMS_SENDER_ID=

# --- Email (Nodemailer) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Sentry (Error Monitoring) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Feature Flags ---
ENABLE_VIDEO_CONSULTATIONS=
ENABLE_AI_SKIN_ANALYSIS=
ENABLE_MARKETPLACE=
ENABLE_SUBSCRIPTION_BOXES=
